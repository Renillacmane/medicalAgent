APP_NAME=${APP_NAME}

# Application Environment
NODE_ENV=${NODE_ENV}
PORT=${PORT}

# JWT Configuration
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES=${JWT_EXPIRES}

# Database Configuration
DB_USER=${DB_USER}
DB_PWD=${DB_PWD}
DB_NAME=${DB_NAME}
MONGODB_URI=${MONGODB_URI}

# LLM Configuration
# Provider selection: 'openai' | 'gemini' (gemini not yet implemented)
LLM_PROVIDER=${LLM_PROVIDER}

# OpenAI Configuration (when LLM_PROVIDER=openai)
OPENAI_API_KEY=${OPENAI_API_KEY}

OPENAI_CHAT_MODEL=${OPENAI_CHAT_MODEL}
OPENAI_TEMPERATURE=${OPENAI_TEMPERATURE}
OPENAI_MAX_TOKENS=${OPENAI_MAX_TOKENS}
OPENAI_EMBEDDING_MODEL=${OPENAI_EMBEDDING_MODEL}

# Gemini Configuration (when LLM_PROVIDER=gemini) - Future
# GEMINI_API_KEY=${GEMINI_API_KEY}
# GEMINI_MODEL=${GEMINI_MODEL}

# Document uploads. Default: frontend/public/documents. For static export (next export → out/), set to frontend/out/documents (absolute path) so new uploads are served.
DOCUMENTS_UPLOAD_DIR=${DOCUMENTS_UPLOAD_DIR}