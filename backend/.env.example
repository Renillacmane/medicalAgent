APP_NAME=Medical AI Agent

# Application Environment
NODE_ENV=development
PORT=3011

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here-minimum-32-characters
JWT_EXPIRES=1h

# Database Configuration
DB_USER=DB_USER
DB_PWD=DB_PWD
DB_NAME=DB_NAME
MONGODB_URI=MONGODB_URI

# LLM Configuration
# Provider selection: 'openai' | 'gemini' (gemini not yet implemented)
LLM_PROVIDER=openai

# OpenAI Configuration (when LLM_PROVIDER=openai)
OPENAI_API_KEY=

OPENAI_CHAT_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=15000
# RAG vector search (same key as above; model must match MongoDB vector index dimensions: 1536)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini Configuration (when LLM_PROVIDER=gemini) - Future
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-pro

# Document uploads. Default: frontend/public/documents. For static export (next export → out/), set to frontend/out/documents (absolute path) so new uploads are served.
# DOCUMENTS_UPLOAD_DIR=
