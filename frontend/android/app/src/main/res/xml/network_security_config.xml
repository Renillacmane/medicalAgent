<?xml version="1.0" encoding="utf-8"?>
<!-- Allow HTTP (cleartext) so the app can call a local backend over LAN (e.g. http://192.168.1.x:3011). -->
<!-- For production, use HTTPS for your API and remove or restrict cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
